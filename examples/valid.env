# All values are illustrative; this file contains no live credentials.
export APP_ENV=production
HTTP_PORT=8080
METRICS_PORT=9090
DATABASE_URL=postgresql://db.example.test:5432/service
DATABASE_PASSWORD='EXAMPLE_NOT_A_REAL_PASSWORD'
API_BASE_URL=https://api.example.test/v1
TLS_ENABLED=true
TLS_CERT_PATH=/etc/service/tls.crt
WORKERS=4
SERVICE_NAME="catalog-service"
